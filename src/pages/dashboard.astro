---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="Dashboard">
  <div class="stats-grid">
    <div class="stat-card"><div class="stat-icon">🔑</div><div class="stat-label">Licencias activas</div><div class="stat-value" id="stat-active">—</div></div>
    <div class="stat-card"><div class="stat-icon">⚠️</div><div class="stat-label">Por vencer (30d)</div><div class="stat-value" id="stat-expiring" style="color:var(--color-warning);">—</div></div>
    <div class="stat-card"><div class="stat-icon">❌</div><div class="stat-label">Vencidas</div><div class="stat-value" id="stat-expired" style="color:var(--color-danger);">—</div></div>
    <div class="stat-card"><div class="stat-icon">🏢</div><div class="stat-label">Clientes</div><div class="stat-value" id="stat-clients">—</div></div>
    <div class="stat-card"><div class="stat-icon">📦</div><div class="stat-label">Productos</div><div class="stat-value" id="stat-products">—</div></div>
    <div class="stat-card"><div class="stat-icon">⏸️</div><div class="stat-label">Suspendidas</div><div class="stat-value" id="stat-suspended" style="color:var(--color-text-secondary);">—</div></div>
  </div>

  <div class="grid-2" style="margin-bottom:1.5rem;">
    <div class="card">
      <div class="card-header"><span class="card-title">Licencias por mes</span><span class="text-muted text-sm">Últimos 6 meses</span></div>
      <div class="card-body"><canvas id="monthly-chart" height="200"></canvas></div>
    </div>
    <div class="card">
      <div class="card-header"><span class="card-title">Distribución por estado</span></div>
      <div class="card-body" style="display:flex;align-items:center;gap:1.5rem;">
        <canvas id="status-chart" width="160" height="160" style="flex-shrink:0;"></canvas>
        <div id="status-legend" style="flex:1;"></div>
      </div>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-header"><span class="card-title">⚠️ Próximas a vencer</span><a href="/licenses" class="btn btn-ghost btn-sm">Ver todas</a></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Cliente</th><th>Producto</th><th>Días</th></tr></thead>
          <tbody id="expiring-table"><tr><td colspan="3" style="text-align:center;color:var(--color-text-muted);">Cargando...</td></tr></tbody>
        </table>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><span class="card-title">📋 Actividad reciente</span><a href="/audit" class="btn btn-ghost btn-sm">Ver logs</a></div>
      <div id="activity-list" style="padding:0.75rem;"></div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
    async function loadDashboard() {
      try {
        const data = await window._api.dashboard();
        document.getElementById('stat-active').textContent    = data.licenses.active;
        document.getElementById('stat-expiring').textContent  = data.expiring_soon;
        document.getElementById('stat-expired').textContent   = data.licenses.expired;
        document.getElementById('stat-clients').textContent   = data.total_clients;
        document.getElementById('stat-products').textContent  = data.total_products;
        document.getElementById('stat-suspended').textContent = data.licenses.suspended;

        const roleColors = { active:'#10B981', expired:'#EF4444', suspended:'#F59E0B', cancelled:'#94A3B8' };
        const roleLabels = { active:'Activas', expired:'Vencidas', suspended:'Suspendidas', cancelled:'Canceladas' };

        new Chart(document.getElementById('monthly-chart').getContext('2d'), {
          type: 'bar',
          data: { labels: data.monthly_licenses.map(r=>r.month), datasets:[{ label:'Licencias', data:data.monthly_licenses.map(r=>r.total), backgroundColor:'#4F46E5', borderRadius:6 }] },
          options: { responsive:true, plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true,ticks:{precision:0}}} }
        });

        const statuses = Object.keys(data.licenses).filter(k=>k!=='total');
        new Chart(document.getElementById('status-chart').getContext('2d'), {
          type: 'doughnut',
          data: { labels:statuses.map(s=>roleLabels[s]||s), datasets:[{ data:statuses.map(s=>data.licenses[s]||0), backgroundColor:statuses.map(s=>roleColors[s]||'#94A3B8'), borderWidth:0 }] },
          options: { cutout:'70%', plugins:{legend:{display:false}} }
        });

        document.getElementById('status-legend').innerHTML = statuses.map(s=>`
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
            <span style="width:10px;height:10px;border-radius:50%;background:${roleColors[s]};flex-shrink:0;"></span>
            <span style="font-size:0.8125rem;color:var(--color-text-secondary);">${roleLabels[s]||s}</span>
            <span style="font-size:0.8125rem;font-weight:600;margin-left:auto;">${data.licenses[s]||0}</span>
          </div>`).join('');

        const tbody = document.getElementById('expiring-table');
        tbody.innerHTML = data.expiring_soon_list?.length
          ? data.expiring_soon_list.map(r=>`<tr><td>${r.client}</td><td>${r.product}</td><td><span class="badge ${r.days_remaining<=7?'badge-expired':'badge-suspended'}">${r.days_remaining}d</span></td></tr>`).join('')
          : '<tr><td colspan="3" class="empty-state">Sin licencias próximas a vencer</td></tr>';

        const icons = { CREATE:'✅', UPDATE:'✏️', DELETE:'🗑️' };
        document.getElementById('activity-list').innerHTML = data.recent_activity?.length
          ? data.recent_activity.map(a=>`<div style="display:flex;gap:10px;padding:0.5rem 0.75rem;border-bottom:1px solid var(--color-border);">
              <span>${icons[a.action]||'•'}</span>
              <div><div style="font-size:0.8125rem;font-weight:500;">${a.user_name||'Sistema'} <span style="color:var(--color-text-muted);font-weight:400;">${a.action.toLowerCase()} ${a.entity}</span></div>
              <div style="font-size:0.75rem;color:var(--color-text-muted);">${new Date(a.created_at).toLocaleString('es-PE')}</div></div>
            </div>`).join('')
          : '<div class="empty-state">Sin actividad reciente</div>';
      } catch(err) {
        window.showToast?.('Error cargando dashboard: ' + err.message, 'danger');
      }
    }
    loadDashboard();
  </script>
</AppLayout>
